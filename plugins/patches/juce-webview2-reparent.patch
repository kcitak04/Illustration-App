@@ -600,10 +600,29 @@ public:
 
     void componentMovedOrResized (bool, bool) override
     {
+        syncParentWindow();
         if (auto* peer = owner.getTopLevelComponent()->getPeer())
             setControlBounds (peer->getAreaCoveredBy (owner));
     }
 
+    // DATTRACK patch: the browser component can move between windows (plugin editor <-> a hidden window that keeps
+    // the page alive), and the WebView2 controller is created asynchronously - possibly for the window the component
+    // has already left. Without re-parenting, WebView2 keeps drawing into that old (hidden) window: a blank editor.
+    void syncParentWindow()
+    {
+        if (webViewController == nullptr)
+            return;
+
+        if (auto* peer = owner.getPeer())
+        {
+            const auto wanted = (HWND) peer->getNativeHandle();
+            HWND current = nullptr;
+
+            if (FAILED (webViewController->get_ParentWindow (&current)) || current != wanted)
+                webViewController->put_ParentWindow (wanted);
+        }
+    }
+
     void componentPeerChanged() override
     {
         componentMovedOrResized (true, true);
